# 鐵正綱工程 內部管理系統 — 排程
#
# 安裝：crontab -e 後貼上，並把 TJG 換成實際路徑
# 設計原則：不養常駐 worker，全部用 cron，省下 Redis + Celery 的記憶體。

TJG=/opt/tjg-inner

# ── 每日 01:00 備份（資料庫 + 附件，本機保留 14 天）─────────────────
0 1 * * * $TJG/deploy/backup.sh >> $TJG/logs/backup.log 2>&1

# ── 每小時記錄資源用量（目標常駐 < 1.5GB，超了要知道）───────────────
0 * * * * docker stats --no-stream --format "{{.Name}}\t{{.MemUsage}}\t{{.CPUPerc}}" >> $TJG/logs/resources.log
