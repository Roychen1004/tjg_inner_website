# =====================================================
# 鐵正綱工程 內部管理系統 — 環境變數
# 依 docs/django_rules.md 規範格式
# 複製成 .env 後即可使用（.env 不進版控）
# =====================================================

# =====================================================
# Default
# =====================================================
LOGS_FOLDER_PATH=./logs/
SECRET_KEY=wivfwi00*-^+yKbQ1fb6Uhb+d2Z4!%FakB)RQss)7%a8b0%dcW
DJANGO_SETTINGS_MODULE=main.settings.local
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# 非標準埠必須明確信任，否則 Admin 登入與所有 POST 會被 CSRF 擋下
CSRF_TRUSTED_ORIGINS=http://localhost:30080,http://127.0.0.1:30080
API_ROOT=api
API_VERSION=v0.1
TIME_ZONE=Asia/Taipei
LANGUAGE_CODE=zh-hant

# =====================================================
# PostgreSQL
# =====================================================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=tjg
POSTGRES_USER=tjg
POSTGRES_PASSWORD=

# =====================================================
# Django 初始管理員（由 manage.py seed_accounts 建立）
# =====================================================
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=neil63075307@gmail.com
SEED_DEMO_PASSWORD=

# =====================================================
# pgAdmin（僅內網，綁 127.0.0.1:5050）
# 連線資訊已預先寫入 deploy/pgadmin/servers.json + pgpass
# 開啟後不需再手動輸入 PostgreSQL 帳密
# =====================================================
PGADMIN_DEFAULT_EMAIL=neil63075307@gmail.com
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_CONFIG_SERVER_MODE=False
PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED=False
PGADMIN_LISTEN_PORT=80

# =====================================================
# 對外埠號（全部落在 30000-32767，避開 Linux 動態埠 32768+）
# =====================================================
PORT_WEB=30080
PORT_API=30800
PORT_DB=30432
PORT_PGADMIN=30050

# =====================================================
# 檔案上傳
# =====================================================
MAX_UPLOAD_SIZE_MB=20
MEDIA_ROOT=/app/media

# 附件下載交給 nginx 送（Django 只檢查權限，不碰檔案內容）。
# ⚠️ 前面沒有 nginx 時（本機 runserver、或直連 api:8000 測試）要設 False，
# 否則下載到的是 0 bytes 的空檔案——而且不會報錯。
# 留空時的預設值：DEBUG=True → False，DEBUG=False → True
# USE_X_ACCEL_REDIRECT=True
