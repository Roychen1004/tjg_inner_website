# 鐵正綱工程 內部管理系統 — 排程
# 安裝：crontab -e 後貼上，並把 /opt/tjg-inner 換成實際路徑
#
# 設計原則（決策 D05）：不養常駐 worker，全部用 cron + management command，
# 省下 Redis + Celery 約 350MB 記憶體。

TJG=/opt/tjg-inner

# ── 每日 02:00 計算前一日 KPI 快照（P2 起有作用）────────────────────
0 2 * * * cd $TJG && docker compose exec -T api python manage.py calc_daily_kpi >> logs/cron.log 2>&1

# ── 工作日 08:00 掃描逾期與異常 ─────────────────────────────────────
# 專案逾期／階段停滯／待簽收逾 7 天／外包逾期未回廠／
# 可請款逾 7 天未開單／已請款逾 60 天未收款／呆滯料／證照到期
0 8 * * 1-5 cd $TJG && docker compose exec -T api python manage.py scan_alerts >> logs/cron.log 2>&1

# ── 每日 01:00 備份 ─────────────────────────────────────────────────
0 1 * * * $TJG/deploy/backup.sh >> $TJG/logs/backup.log 2>&1

# ── 每月 1 日 03:00 月度彙總 ────────────────────────────────────────
0 3 1 * * cd $TJG && docker compose exec -T api python manage.py calc_monthly_kpi >> logs/cron.log 2>&1

# ── 每月 1 日 03:30 月底庫存快照（庫存週轉率的分母）─────────────────
30 3 1 * * cd $TJG && docker compose exec -T api python manage.py snapshot_inventory >> logs/cron.log 2>&1

# ── 每月 1 日 04:00 清理過期動態與通知 ──────────────────────────────
# ActivityLog 保留 2 年、已讀通知保留 6 個月
0 4 1 * * cd $TJG && docker compose exec -T api python manage.py purge_old_logs >> logs/cron.log 2>&1

# ── 每小時記錄資源用量（監控用，目標常駐 < 1.5GB）──────────────────
0 * * * * docker stats --no-stream --format "{{.Name}}\t{{.MemUsage}}\t{{.CPUPerc}}" >> $TJG/logs/resources.log
